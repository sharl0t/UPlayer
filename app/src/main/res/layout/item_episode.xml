<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка серии 16:9, 264x149dp (макет 352x198) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="264dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="21dp"
    android:clipChildren="false"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="264dp"
        android:layout_height="149dp"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/ep_card_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dark"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/ep_card_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/duration_badge"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/focus_ring_gap_neg"
            android:background="@drawable/focus_ring_selector"
            android:duplicateParentState="true" />
    </FrameLayout>

    <TextView
        android:id="@+id/ep_card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_focus_name"
        android:textSize="17sp" />
</LinearLayout>
