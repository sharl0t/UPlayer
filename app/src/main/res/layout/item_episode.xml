<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка серии 16:9, 264x149dp (макет 352x198) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="176dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:clipChildren="false"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="176dp"
        android:layout_height="99dp"
        android:clipChildren="false"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/ep_card_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dark"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/ep_card_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="5dp"
            android:background="@drawable/duration_badge"
            android:paddingStart="5dp"
            android:paddingTop="1dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:textColor="@color/text"
            android:textSize="9sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/focus_ring_selector"
            android:duplicateParentState="true" />
    </FrameLayout>

    <TextView
        android:id="@+id/ep_card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:duplicateParentState="true"
        android:textColor="@color/text_focus_name"
        android:textSize="13sp" />
</LinearLayout>
