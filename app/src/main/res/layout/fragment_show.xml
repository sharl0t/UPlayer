<?xml version="1.0" encoding="utf-8"?>
<!-- Экран передачи по design/main-screen.html (.showscr). Размеры макета ×0.5 в dp -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand">

    <!-- Шапка: «Ю», название, «N сезонов · M серий», подсказка «Назад» -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/logo_square"
            android:gravity="center"
            android:text="Ю"
            android:textColor="@color/letter"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/show_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/show_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/plate"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_back_hint"
            android:textColor="@color/plate"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Колонка сезонов слева -->
    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/seasons"
        android:layout_width="170dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="80dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nextFocusRight="@id/episodes" />

    <!-- Блок выбранной серии: картинка и текст -->
    <FrameLayout
        android:id="@+id/ep_block"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginStart="250dp"
        android:layout_marginTop="75dp"
        android:layout_marginEnd="48dp">

        <ImageView
            android:id="@+id/ep_image"
            android:layout_width="320dp"
            android:layout_height="180dp"
            android:background="@color/dark"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/ep_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="350dp"
            android:layout_marginTop="17dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ep_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ep_who"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:maxLines="3"
                android:textColor="@color/text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/ep_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:textColor="@color/plate"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/ep_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/ep_watch_hint"
                android:textColor="@color/plate"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Ряд серий -->
    <androidx.leanback.widget.HorizontalGridView
        android:id="@+id/episodes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="235dp"
        android:layout_marginTop="278dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nextFocusLeft="@id/seasons"
        android:paddingStart="15dp"
        android:paddingTop="12dp"
        android:paddingEnd="48dp"
        app:rowHeight="wrap_content" />

    <!-- Надпись, если у передачи нет серий: по центру под шапкой, скрыта, пока есть сезоны -->
    <TextView
        android:id="@+id/show_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:text="@string/no_episodes"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:visibility="gone" />
</FrameLayout>
