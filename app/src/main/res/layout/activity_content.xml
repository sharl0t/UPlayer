<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Картинка передачи на весь экран: в неё «разворачивается» карточка каталога (ShowActivity.open).
         Лежит под содержимым, при выходе сворачивается обратно в карточку -->
    <ImageView
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Загрузка: квадрат «Ю», мягко мигает (анимация в LoadActivity) -->
    <TextView
        android:id="@+id/progress"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:background="@drawable/logo_square"
        android:gravity="center"
        android:text="Ю"
        android:textColor="@color/letter"
        android:textSize="60sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
