<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка передачи: картинка 194x166dp (макет 258x221), затемнение без фокуса, рамка в фокусе, название.
     Подъём и бегущая строка включаются из MainFragment по фокусу -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="129dp"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="129dp"
        android:layout_height="111dp"
        android:clipChildren="false"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/dark"
            android:scaleType="centerCrop" />

        <!-- Затемнение карточек без фокуса: состояние берёт у карточки -->
        <View
            android:id="@+id/dim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_dim_selector"
            android:duplicateParentState="true" />

        <!-- Рамка фокуса вокруг картинки, отступ наружу -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/focus_ring_selector"
            android:duplicateParentState="true" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="18dp"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:duplicateParentState="true"
        android:textColor="@color/text_focus_name"
        android:textSize="13sp" />
</LinearLayout>
