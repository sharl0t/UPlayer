<?xml version="1.0" encoding="utf-8"?>
<!-- Главный экран по design/main-screen.html. Размеры макета (1920x1080 px) умножены на 0.75 в dp -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand">

    <!-- Фон: две картинки для плавной смены и два градиента поверх -->
    <ImageView
        android:id="@+id/bg_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/bg_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_shade_side" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_shade_bottom" />

    <!-- Шапка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/logo_square"
            android:gravity="center"
            android:text="Ю"
            android:textColor="@color/letter"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:text="Player"
            android:textColor="@color/plate"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="9dp"
            android:textColor="@color/plate"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/settings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/gear_button"
            android:contentDescription="@string/settings"
            android:focusable="true"
            android:nextFocusDown="@id/grid"
            android:padding="8dp"
            android:src="@drawable/ic_settings_dark" />
    </LinearLayout>

    <!-- Верхний блок выбранной передачи (заполняет MainFragment) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="48dp">

        <ImageView
            android:id="@+id/hero_image"
            android:layout_width="147dp"
            android:layout_height="110dp"
            android:background="@color/dark"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="175dp"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@color/text"
                android:textSize="29sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/hero_bar"
                android:layout_width="70dp"
                android:layout_height="4dp"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="9dp"
                android:background="@color/plate"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/hero_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/plate"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Сетка на 6 колонок, снизу под верхним блоком -->
    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="171dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="48dp"
        android:paddingTop="40dp"
        android:paddingEnd="48dp"
        app:columnWidth="129dp"
        app:numberOfColumns="6"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- Полоса прокрутки справа: дорожка и ползунок (двигает MainFragment) -->
    <View
        android:id="@+id/scroll_track"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="196dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="24dp"
        android:background="#26ffffff" />

    <View
        android:id="@+id/scroll_thumb"
        android:layout_width="3dp"
        android:layout_height="40dp"
        android:layout_gravity="end"
        android:layout_marginTop="196dp"
        android:layout_marginEnd="22dp"
        android:background="@color/focus" />
</FrameLayout>
