<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:colorAccent">@color/focus</item>
        <item name="searchOrbViewStyle">@style/SettingsOrb</item>
    </style>

    <!-- Кнопка в заголовке каталога: поиска в приложении нет, на её месте вход в настройки -->
    <style name="SettingsOrb" parent="Widget.Leanback.SearchOrbViewStyle">
        <item name="searchOrbIcon">@drawable/ic_settings_dark</item>
        <item name="searchOrbColor">@color/plate</item>
    </style>

    <!-- Настройки (GuidedStep): фон и пункты в палитре логотипа, фокус светлой плашкой с рамкой -->
    <style name="SettingsTheme" parent="Theme.Leanback.GuidedStep">
        <item name="android:colorAccent">@color/focus</item>
        <item name="guidedStepBackground">@color/brand</item>
        <item name="guidedActionsBackground">@color/dark</item>
        <item name="guidedActionsBackgroundDark">@color/dark</item>
        <item name="guidedActionsSelectorDrawable">@drawable/guided_selector</item>
    </style>

    <!-- Плеер: чёрный фон по краям видео -->
    <style name="PlayerTheme" parent="AppTheme">
        <item name="android:windowBackground">@android:color/black</item>
        <!-- Панель, полоса прокрутки и подсветка кнопок в палитре логотипа -->
        <item name="defaultBrandColor">@color/dark</item>
        <item name="defaultBrandColorDark">@color/dark</item>
        <item name="playbackProgressPrimaryColor">@color/focus</item>
        <item name="playbackProgressSecondaryColor">#66c6c7cb</item>
        <item name="playbackControlsIconHighlightColor">@color/focus</item>
        <item name="android:alertDialogTheme">@style/PlayerDialog</item>
    </style>

    <!-- Выбор качества: тёмный диалог с плашкой в цвете логотипа -->
    <style name="PlayerDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorBackground">@color/brand</item>
        <item name="android:colorAccent">@color/focus</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/plate</item>
    </style>
</resources>
