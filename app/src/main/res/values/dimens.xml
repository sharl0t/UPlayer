<?xml version="1.0" encoding="utf-8"?>
<!-- Размеры фокуса и скруглений, макет design/main-screen.html; без увеличения карточки (design/PLAN.md) -->
<resources>
    <!-- Рамка фокуса: толщина и отступ от картинки наружу -->
    <dimen name="focus_ring_width">6dp</dimen>
    <dimen name="focus_ring_gap">9dp</dimen>
    <!-- Скругление картинки карточки и внешнее скругление рамки (картинка + отступ) -->
    <dimen name="card_radius">14dp</dimen>
    <dimen name="focus_ring_radius">23dp</dimen>
    <!-- Подъём карточки в фокусе -->
    <dimen name="focus_lift">8dp</dimen>
    <!-- Скругление светлой плашки фокуса (сезон, кнопка) -->
    <dimen name="plate_radius">14dp</dimen>
</resources>
