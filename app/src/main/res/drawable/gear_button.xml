<?xml version="1.0" encoding="utf-8"?>
<!-- Кнопка настроек в шапке: светлый круг, в фокусе ярче и с рамкой -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/focus" />
            <stroke android:width="@dimen/focus_ring_width" android:color="@color/text" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/plate" />
        </shape>
    </item>
</selector>
