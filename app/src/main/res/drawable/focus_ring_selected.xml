<?xml version="1.0" encoding="utf-8"?>
<!-- Тонкая рамка у выбранной серии, когда фокус ушёл на колонку сезонов; рисуется на отступ наружу от картинки (отрицательные отступы слоя: отрицательный layout_margin не растягивает вид) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="@dimen/focus_ring_gap_neg"
        android:top="@dimen/focus_ring_gap_neg"
        android:right="@dimen/focus_ring_gap_neg"
        android:bottom="@dimen/focus_ring_gap_neg">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/focus_ring_radius" />
            <stroke
                android:width="2dp"
                android:color="#99e4e5e8" />
        </shape>
    </item>
</layer-list>
